					{% elsif Variant == '1:26.1 R2500 BX 60E1 (KO-701399)' %}48.109
					{% endif %}" AttMirrorX="{% if quadrant == '2' or quadrant == '3' %}true{% else %}false{% endif %}" AttMirrorY="{% if quadrant == '1' or quadrant == '2' %}true{% else %}false{% endif %}">
