   <OwnAlignmentTargetSpace>spor</OwnAlignmentTargetSpace>
   <JigSymbolAppearance AddAngle="-90" EnableDirectionSetting="true" MirrorAboutJigXAxisIfLeftSideOfAlignment="true"/>
