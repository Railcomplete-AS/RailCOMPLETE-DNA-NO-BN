  <InsertPointObject Name="Pipe mast Ã127 for railway signal, 3.2m" DisplayBlockName="NO-BN-2D-JBTSA_FUN-RØRMAST-127-MED-LJERN-FOR-SIGNAL-3200-{{SymbolMode}}" DefaultSnapMode="Point" SnapToAlignment="true" SnapDistance="3.5">
