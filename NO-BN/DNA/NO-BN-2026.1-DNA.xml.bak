   <SetValue Key="Parent" Value="ACS"/>
  </DynamicProperty>
  <LuaExpression Name="Geometry3D_0.Rotation.Z">
   <Formula>NOBN_trk_getYawFromDir()</Formula>
  </LuaExpression>
  <SetValue Key="EarthingMethod" Value="Rail"/>
  <LuaExpression Name="EarthingLabelColor">
   <Formula>NOBN_com_assignEarthingLabelColor()</Formula>
  </LuaExpression>
  <Variants>
   <Variant Name="Key lock cabinet, left-hinged"/>
   <Variant Name="Key lock cabinet, right-hinged"/>
   <Variant Name="Crank cabinet, left-hinged"/>
   <Variant Name="Crank cabinet, right-hinged"/>
   <Variant Name="Small signalling cabinet, left-hinged"/>
   <Variant Name="Small signalling cabinet, right-hinged"/>
   <Variant Name="Cable box 280x190x100 on Ø76 pipe mast, left-hinged"/>
   <Variant Name="Cable box 280x190x100 on Ø76 pipe mast, right-hinged"/>
   <Variant Name="Cable box 280x190x100 on Ø127 pipe mast, left-hinged"/>
   <Variant Name="Cable box 280x190x100 on Ø127 pipe mast, right-hinged"/>
   <Variant Name="Cable box 280x190x165 on Ø76 pipe mast, left-hinged"/>
   <Variant Name="Cable box 280x190x165 on Ø76 pipe mast, right-hinged"/>
   <Variant Name="Cable box 280x190x165 on Ø127 pipe mast, left-hinged"/>
   <Variant Name="Cable box 280x190x165 on Ø127 pipe mast, right-hinged"/>
  </Variants>
  <LuaExpression Name="Geometry3D_0.Offset.Z">
   <Formula>(Variant:lower():find("key lock cabinet") or Variant:lower():find("crank cabinet")) and 1.50 or 1.20</Formula>
  </LuaExpression>
  <LuaExpression Name="Geometry3D_0.PoleRouting">
   <Formula>"Vertical"</Formula>
  </LuaExpression>
  <LuaExpression Name="Geometry3D_0.Name">
   <Formula>_JBTSA_APS_SignallingCableDistributionBox_Geometry3DName()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTSA_APS_SignallingCableDistributionBox_Geometry3DName()" ReturnType="String" Description="Returns the signalling cable distribution box's 3D geometry name.">
   <Signature>String _JBTSA_APS_SignallingCableDistributionBox_Geometry3DName()</Signature>
   <Formula>
				function _JBTSA_APS_SignallingCableDistributionBox_Geometry3DName()
					if Variant == "Key lock cabinet, left-hinged" then
						return "NO-BN-3D-SA-NØK-NØKKELSKAP-250x350x230-Ø76"
					elseif Variant == "Key lock cabinet, right-hinged"	then
						return "NO-BN-3D-SA-NØK-NØKKELSKAP-250x350x230-Ø76"
					elseif Variant == "Large signalling cabinet, double door"	then
						return "NO-BN-3D-SA-APS-APPARATSKAP-STORT-1200x1200x400-MED-SOKKEL"
					elseif Variant == "Crank cabinet, left-hinged"	then
						return "NO-BN-3D-SA-SVB-SVEIVSKAP-500x760x320-Ø76"
					elseif Variant == "Crank cabinet, right-hinged"	then
						return "NO-BN-3D-SA-SVB-SVEIVSKAP-500x760x320-Ø76"
					elseif Variant == "Small signalling cabinet, left-hinged"	then
						return "NO-BN-3D-FE-DIV-UKJENT"
					elseif Variant == "Small signalling cabinet, right-hinged"	then
						return "NO-BN-3D-FE-DIV-UKJENT"
					elseif Variant == "Cable box 280x190x100 on Ø76 pipe mast, left-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x100-Ø76"
					elseif Variant == "Cable box 280x190x100 on Ø76 pipe mast, right-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x100-Ø76"
					elseif Variant == "Cable box 280x190x100 on Ø127 pipe mast, left-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x100-Ø127"
					elseif Variant == "Cable box 280x190x100 on Ø127 pipe mast, right-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x100-Ø127"
					elseif Variant == "Cable box 280x190x165 on Ø76 pipe mast, left-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x165-Ø76"
					elseif Variant == "Cable box 280x190x165 on Ø76 pipe mast, right-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x165-Ø76"
					elseif Variant == "Cable box 280x190x165 on Ø127 pipe mast, left-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x165-Ø127"
					elseif Variant == "Cable box 280x190x165 on Ø127 pipe mast, right-hinged"	then
						return "NO-BN-3D-SA-SIG-NSI63-KABELBOKS-190x280x165-Ø127"
					else
						return "Could not find 3D geometry name for variant"
					end
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="dir">
   <Formula>"both"</Formula>
  </LuaExpression>
  <LuaExpression Name="name">
   <Formula>NOBN_sig_getCabinetName()</Formula>
  </LuaExpression>
  <LuaExpression Name="Tag">
   <Formula>
				if Variant:lower():match("key lock") then return "SA-NØK-000000"
				elseif Variant:lower():match("crank") then return "SA-SVB-000000"
				elseif Variant:lower():match("signalling cabinet") then return "SA-APS-000000"
				elseif Variant:lower():match("cable") then return "SA-APS-000000"
				else return "UNFINISHED - Unrecognized variant ["..Variant.."] - cannot deduce Bane_NOR.BaneData_ID."
				end
			</Formula>
  </LuaExpression>
