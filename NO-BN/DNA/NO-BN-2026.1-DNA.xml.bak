  </InsertPointObject>
  <InsertPointObject Name="Cable box 280x190x100 on Ø76 pipe mast, right-hinged" DisplayBlockName="NO-BN-2D-JBTSA_APS-KABELBOKS-HHENGSLET-{{SymbolMode}}" DefaultSnapMode="Point" SnapToAlignment="true" SnapDistance="3.5" AskForAttachment="true">
