  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTNAVN" Layer="JBTSA@OBJEKTNAVN" Color="ByBlock" Justify="MiddleCenter" Height="1.25" Rotation="0" ObliqueAngle="15"/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTID" Layer="JBTSA@OBJEKTID" Color="ByLayer" Justify="MiddleCenter" Height="0.9" Rotation="0" ObliqueAngle="0"/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTINFO" Layer="JBTSA@OBJEKTINFO" Color="ByBlock" Justify="MiddleCenter" Height="0.9" Rotation="0" ObliqueAngle="0" IsMtext="true"/>
  <LuaExpression Name="TextAttribute_OBJEKTNAVN.Content">
