  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTID" Layer="JBTSA@OBJEKTID" Color="ByLayer" Justify="MiddleCenter" Height="0.9" Rotation="-90" ObliqueAngle="0"/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTINFO" Layer="JBTSA@OBJEKTINFO" Color="ByBlock" Justify="MiddleCenter" Height="0.9" Rotation="-90" ObliqueAngle="0" IsMtext="true"/>
