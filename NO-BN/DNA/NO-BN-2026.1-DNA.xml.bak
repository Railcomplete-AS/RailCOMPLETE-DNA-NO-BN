  <CustomProperty DataType="Enumeration" Name="MainSignal" DisplayName="Main signal" DefaultValue="-" Description="Bane NOR 1/2/3-lantern optical main signal.\n20a=*Red:Stop(entry/block)\n20b=Red:Stop(intermediate/exit)\n21(3-light main)=UpperGreen:Proceed with caution\n21(2-light main)=LowerGreen:Proceed with caution\n21(repeater)=UpperGreen:Proceed with caution\n22=UpperGreen+LowerGreen:Proceed.">
   <Values>
    <Value>-</Value>
    <Value>Hs1</Value>
    <Value>Hs2</Value>
