   <OwnAlignmentTargetSpace>spor</OwnAlignmentTargetSpace>
   <SetValue Key="MileageIncreasesTowardsLeft" Value="{{alignmentRotation | minus:ucsRotation | cosisnegative}}"/>
  </InsertPointObject>
