  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTNAVN" Layer="JBTKO@OBJEKTNAVN" Color="ByBlock" Justify="MiddleCenter" Height="1.25" Rotation="-90" ObliqueAngle="15"/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTID" Layer="JBTKO@OBJEKTID" Color="ByLayer" Justify="MiddleCenter" Height="0.9" Rotation="-90" ObliqueAngle="0"/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTINFO" Layer="JBTKO@OBJEKTINFO" Color="ByBlock" Justify="MiddleCenter" Height="0.9" Rotation="-90" ObliqueAngle="0" IsMtext="true"/>
  <LuaExpression Name="TextAttribute_OBJEKTNAVN.Content">
   <Formula>name</Formula>
  </LuaExpression>
  <LuaExpression Name="TextAttribute_OBJEKTID.Content">
   <Formula>Tag</Formula>
  </LuaExpression>
