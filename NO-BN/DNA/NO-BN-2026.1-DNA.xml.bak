  <LuaFunction Name="_JBTSA_SPD_code()" ReturnType="String" Description="Returns the code for a derailer machine, derived from the derailer it is related to with '&quot;..rel_DerailerMachine_BelongsTo_Derailer..&quot;'.">
   <Signature>String _JBTSA_SPD_code()</Signature>
   <Formula>
				function _JBTSA_SPD_code()
					local s = rel_DerailerMachine_BelongsTo_Derailer
					local r, n = getRelatedObjects(s)
					if n == 0 then
						return "UNFINISHED - Missing relation '"..s.."' to derailer object.",_warning
					else
						return r[0].code
					end
				end
			</Formula>
  </LuaFunction>
