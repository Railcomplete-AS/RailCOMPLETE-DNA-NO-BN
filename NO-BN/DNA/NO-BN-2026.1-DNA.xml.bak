      <Title>Mot km-retn.</Title>
      <Sort/>
      <Guid>96431658-43eb-4e9a-ad75-adbb1efe6f72</Guid>
      <Alignment>MiddleCenter</Alignment>
     </ColumnSpecification>
     <ColumnSpecification>
      <Headers>
       <Header>
        <Title>Dokumentnummer:</Title>
       </Header>
       <Header>
        <Title>Revisjon:</Title>
       </Header>
       <Header>
        <Title>Dato</Title>
       </Header>
       <Header>
        <Title/>
       </Header>
      </Headers>
      <Width>350</Width>
      <Data>
--Find relevant related object(s):
local r1 = getRelatedObjects(rel_EtcsBalise_BelongsTo_EtcsBaliseGroup)
local r2 = getRelatedObjects(rel_NssBalise_BelongsTo_NssBaliseGroup)
local r3 = getRelatedObjects(rel_BoardOfTypeMoveablePointFrog_AppliesTo_Switch)
local r5 = getRelatedObjects(rel_MarkerPole_Locates_AxleCounter)
local r4 = getRelatedObjects("Montert på skiltfeste/signal/markerboard/skilt/kl-mast")
local r = getUnionOfCollections({r1, r2, r3, r4, r5})
local nRelated = getCollectionLength(r)

--Look for more boards at the same location:
local peerRadius = 0.65 --m
local peers = getNearbyPointObjects2D(peerRadius):filter(
	function (x)
		--Tolerate legacy DNAs with errors in RcType spelling:
		return (x.RcType:match("JBTSA_SIG") or x.RcType:match("JBTEH_BKT") or x.RcType:match("JBTKO_SKT") or x.RcType:match("JBTSA_MSS") or x.RcType:match("JBTFE_DIV")  --Modern DNAs
				or x.RcType:match("FE%-DIV") or x.RcType:match("KO%-SKT") or x.RcType:match("SA%-MSS"))
			and not x.Variant:lower():match("refl")
	end)
--Drop peers that are already related:
peers = peers:filter(
	function (x)
		local found
		for i = 0, nRelated-1 do
			if x.id == r[i].id then
				found = true
			end
		end
		return not found 
	end)
local nPeers = getCollectionLength(peers)
local signalPeers = peers:filter(function (x) return x.RcType:match("JBTSA_SIG") end)
local nSignalPeers = getCollectionLength(signalPeers )

if Variant == nil or Variant == "" then return "Ukjent type: ["..RcType.."]." end

local function identify(x)
	local t = x.RcType:match("JBTKO_SPV") and "sporveksel " or ""
	if x.name and x.name ~= "" then return t..x.name
	elseif x.code and x.code ~= "" then return t..x.code
	else
		if x.RcType:match("FE%-DIV") or x.RcType:match("KO%-SKT") or x.RcType:match("SA%-MSS") 
		or x.RcType:match("JBTFE_DIV")  or x.RcType:match("JBTKO_SKT") or x.RcType:match("JBTSA_MSS") then
			return t..x.Variant --alternatively: RcType:sub(8)
		else
			return t..x.RcType:sub(11)
		end
	end
end

local t
if nRelated == 0 then
	if nPeers == 0 then
		--Free-standing pole or board with no obvious reason to be there
		return Variant.."."

	elseif nSignalPeers &gt; 0 then
		--Board co-located with optical signal
		return Variant..", på "..identify(signalPeers[0]).."." --Boards mounted on optical signal

	else
		--Board co-located with something else than an optical signal, probably other boards
		t = Variant
	end		

else --nRelated &gt; 0:
	--På signal, skiltfeste eller KL-mast / ved balisegruppe, sporveksel, tellepunkt
	if r[0].RcType:match("JBTSA_SIG") or r[0].RcType:match("JBTEH_BKT") or r[0].RcType:match("JBTEH_MAS") then
		t = Variant..", på "..identify(r[0])
	else
		t = Variant..", ved "..identify(r[0])
	end
end

if nPeers &gt; 0 then
	t = t..", på samme mast / stolpe som "
	for i = 0, nPeers-1 do
		t = t..identify(peers[i])
		if i &lt; nPeers-2 then
			t = t..", "
		elseif i &lt; nPeers-1 then
			t = t.." og "
		end
	end
end

return t.."."

						</Data>
