   <Variant Name="Short/short S-connector"/>
   <Variant Name="Short/long S-connector"/>
   <Variant Name="Long/short S-connector"/>
   <Variant Name="Long/long S-connector"/>
   <Variant Name="FTGS end connector"/>
   <Variant Name="FTGS diamond crossing connector"/>
  </Variants>
