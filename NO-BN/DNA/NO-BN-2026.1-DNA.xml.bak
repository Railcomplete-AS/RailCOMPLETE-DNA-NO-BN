    <SetValue Key="dir" Value="both"/>
    <SetValue Key="Geometry3D_0.Name" Value="NO-BN-3D-EL-LYS-LYSMAST-{{EL_LYS_SubVariant}}-U{{EL_LYS_Arm_Length}}-H{EL_LYS_PoleHeight}}{% if EL_LYS_Foundation == 'Yes' %}-{{ EL_LYS_Foundation }}{% endif %}"/>
