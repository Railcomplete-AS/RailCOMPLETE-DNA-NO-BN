  <DockPointDefinitions>
   <SnapPoints>
    <SnapPoint X="0" Y="0" TargetSpace="apparatskapfundament"/>
   </SnapPoints>
  </DockPointDefinitions>
 </ObjectType>
 <ObjectType DataType="tOrientedElement" Class="RailwayPlacedObject" LuaName="rctype_SignallingCableDistributionBox" Name="JBTSA_APS Small cabinet and box" Layer="JBTSA_APS" Color="ByLayer" Group="Signal/Cabinets and boxes" AttMirrorY="{% if RightSided %}true{% else %}false{% endif %}">
  <RelationSpace>kabelboks</RelationSpace>
  <AttachmentCategory Name="kabelboks"/>
