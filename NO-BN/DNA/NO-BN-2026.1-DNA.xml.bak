	end
else
	return "Unrecognized RcType"
end

r = m:getAlignmentInfo().CurveRadius
	if math.abs(r) &gt; 5e5 then 
		return "RL"
	else
		if m:getAlignmentInfo().CurveRotation:upper() == "CCW" then
			return string.format("%.0f",-r)
		else
			return string.format("%.0f",r)
	end
