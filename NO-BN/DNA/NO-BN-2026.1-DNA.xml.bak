  </LuaExpression>
  <Variants>
   <Variant Name="(Line start/end)"/>
   <Variant Name="KP"/>
   <Variant Name="FKP"/>
   <Variant Name="OB"/>
   <Variant Name="OE"/>
   <Variant Name="FOB"/>
   <Variant Name="FOE"/>
   <Variant Name="RB"/>
   <Variant Name="RE"/>
   <Variant Name="REB"/>
  </Variants>
