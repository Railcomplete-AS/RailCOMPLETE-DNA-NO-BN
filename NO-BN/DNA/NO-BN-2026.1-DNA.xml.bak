    <CustomCollectionLuaFilter>local allBalloons = table.where(DocumentData.ObjectCollection,function (x) return x.RcType == rctype_Balloon end)
local balloonCounts = {}

for k,v in pairs(allBalloons) do
	if balloonCounts[v.Content] == nil then
		balloonCounts[v.Content] = {designator = v.Content, balloonItems = {v.Attachment}, itemCount = 1}
	else
		balloonCounts[v.Content].balloonItems = {v.Attachment, table.unpack(balloonCounts[v.Content].balloonItems)}
		balloonCounts[v.Content].itemCount = balloonCounts[v.Content].itemCount + 1
	end
end

local t = {}
local n = 0
for k,v in pairs(balloonCounts) do
	--Transfer table indexed by balloon content names to table with numeric indices (not alphanumeric indices).
	n = n + 1
	table.insert(t, {index = n, designator = v.designator, count = v.itemCount, items = v.balloonItems})
end
return t --Ends up as a C# collection of C# collections, i.e. 'items' becomes an array indexed from 0 to Len-1.</CustomCollectionLuaFilter>
