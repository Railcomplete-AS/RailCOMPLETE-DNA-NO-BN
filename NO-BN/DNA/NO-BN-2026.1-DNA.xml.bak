      <Width>50</Width>
      <Data>d = math.abs(DistanceToAlignment)
if d &lt; 1.8 then return "Bad dist: "..d  --less than this and the poor sign/board will be hit by a train  
elseif RightSided then return "Høyre"
else return "Venstre" 
end</Data>
