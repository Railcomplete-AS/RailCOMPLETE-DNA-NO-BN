      <SortOption>None</SortOption>
      <Alignment>MiddleCenter</Alignment>
      <Data>local a = RC__round(getAlignmentInfo(Alignment.id).CurveRadius, 1)
local b = RC__round(getAlignmentInfo(TargetAlignment.id).CurveRadius, 1)
local c = a &gt; b and a.."/"..b or b.."/"..a
local d = c:gsub("inf","-")
return d</Data>
