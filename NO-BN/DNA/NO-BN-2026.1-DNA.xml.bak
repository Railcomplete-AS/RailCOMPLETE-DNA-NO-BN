  <CustomProperty DataType="String" Name="TextAbove" DisplayName="Text above" DefaultValue="" Description="Text above balise symbol [string] according to Bane NOR TRV 550 ch. 10 ATC tables 7.1 and 7.2."/>
  <LuaExpression Name="TextAbove">
   <Formula>_JBTSA_ETB_TextAbove()</Formula>
