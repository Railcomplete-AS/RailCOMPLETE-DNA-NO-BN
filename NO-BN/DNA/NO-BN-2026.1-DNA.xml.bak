       <Header Name="OH [mm]"/>
      </Headers>
      <Width>10</Width>
      <Sort/>
      <Alignment>MiddleCenter</Alignment>
      <Data>local c = getAlignmentInfo().Cant
											if (RC__isNan(c)) then
												return "-"
											else
												return string.format("%.0f",c)
											end
										</Data>
     </ColumnSpecification>
     <ColumnSpecification>
