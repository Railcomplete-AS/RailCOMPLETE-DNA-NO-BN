  <InsertPointObject Name="Bored Hs foundation, Ø555" DisplayBlockName="NO-BN-2D-JBTKU_FUN-SIGNALFUNDAMENT-BETONG-BORET-Ø555-164x164xM32-{{SymbolMode}}" DefaultSnapMode="Point" SnapToAlignment="true" SnapDistance="3.5">
   <OwnAlignmentTargetSpace>spor</OwnAlignmentTargetSpace>
