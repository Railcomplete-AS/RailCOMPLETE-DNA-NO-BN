  <CustomProperty DataType="Double" Name="SpanlengthTextLongitudinalOffset" DisplayName="Longitudinal Span Text Offset" DefaultValue="0" Description="The span length(s) text longitudinal offset [m] denotes the distance, along the pole's local track direction, to offset the spanlength text."/>
  <TextAttribute Annotative="true" Style="RC-ARIAL" BindingProperty="SpanlengthDisplay" CadAttributeTag="SPENNLENGDE" X="15" Y="5" Layer="JBTEH@SPENNLENGDE" Justify="MiddleCenter" Height="0.9" Width="0" Rotation="0" ObliqueAngle="0" MText="true" ScalePosition="false" IsMText="true" Description="Spanlengths [m] are calculated as the 2D distance from one cantilever (or wire tension balancer) to the next along the contact wire that spans from one to the other."/>
