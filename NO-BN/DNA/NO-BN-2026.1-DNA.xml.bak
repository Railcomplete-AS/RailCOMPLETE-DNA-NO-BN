 <ObjectType DataType="RailCOMPLETESection" Class="RailwayPlacedObject" LuaName="rctype_VerticalProfileSegment" Name="JBTKO_VES Vertical profile segment" Layer="JBTKO_VES" Color="ByLayer" Group="Track superstructure/Characteristic route points" AttMirrorY="{% if RightSided %}true{% else %}false{% endif %}">
