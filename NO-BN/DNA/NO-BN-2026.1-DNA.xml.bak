  <LuaFunction Name="_JBTEH_BAR_code()" ReturnType="String" Description="Returns the code for the OCS guywire, inherited from its OCS pole's force relaying console.">
   <Signature>String _JBTEH_BAR_code()</Signature>
   <Formula>
				function _JBTEH_BAR_code()
					local t
					--TODO: Take into consideration more than one force relaying console to same OCS pole, add a unique suffix number to the code for all the guywires present.
					local sAnp = rel_GuyWireOrSpannerOrWtb_IsAttachedTo_ConsoleOnOcsPole
					local rAnp, nAnp = getRelatedObjects(sAnp)
					if nAnp == 0 then
						return _unfinished,"UNFINISHED - Relate to its force relaying console on OCS pole."
					else
						local anp = rAnp[0]

						if anp.Variant == "Bracket on pole for tension balancer and guy wire" then
							--guywire to counteract the WTB's forces on OCS pole:
							t = "-B"

						elseif anp.Variant == "Bracket on pole for tension balancer" then
							return _error,"ERROR - Guywire is not compatible with a bracket for tension balancer only (no guywire expected)."

						else
							return _error,"ERROR - Unrecognized bracket Variant '"..anp.Variant.."'."
						end

						local sPol = rel_ConsoleOnOcsPole_IsInstalledOn_OcsPole
						local rPol, nPol = getRelatedObjects(sPol, rAnp[0])
						if nPol == 0 then
							return _unfinished,"UNFINISHED - The related force relaying console has no relation to a its OCS pole, cannot deduce guywire's code."
						else
							return rPol[0].code..t
						end
					end
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="name">
   <Formula>_JBTEH_BAR_name()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_BAR_name()" ReturnType="String" HideFromUser="false" Description="Returns the name for the OCS catenary wire guywire, derived from its code.">
   <Signature>String _JBTEH_BAR_name()</Signature>
   <Formula>
				function _JBTEH_BAR_name()
					return "Bar."..code
				end
			</Formula>
  </LuaFunction>
