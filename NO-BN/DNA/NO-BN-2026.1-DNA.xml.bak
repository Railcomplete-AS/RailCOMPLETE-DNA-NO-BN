      <Headers>
       <Header Name="Utligger"/>
       <Header Name="Kth [m]"/>
      </Headers>
      <Width>15</Width>
      <Sort/>
      <Alignment>MiddleCenter</Alignment>
      <Data>cnt, nCnt = getRelatedObjects(rel_OcsPole_Has_Cantilever)
for i = 0, nCnt-1 do
	s = cnt[i].ContactWireHeight
	t = t and t.."/"..s or s
end
return t or ""</Data>
