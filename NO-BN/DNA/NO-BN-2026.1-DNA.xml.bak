  <SymbolDefinition DefaultBlockName="NO-BN-2D-JBTEH_FUN-KL-FUNDAMENT-BETONG-BJELKEMAST-1600x1800-000-191x374xM36-{{SymbolMode}}" AllowSymbolMove="true">
   <Rotation Add180DegreesIfDirIsDown="false" AddAngle="{% if dir == 'up' %}{{270.0|plus:AngularOffset}}
														{% elsif dir == 'down' %}{{90.0|plus:AngularOffset}}
														{% elsif dir == 'both' and RightSided %}{{180.0|plus:AngularOffset}}
														{% elsif dir == 'both' and LeftSided %}{{0.0|plus:AngularOffset}}
														{% elsif dir == 'none' and RightSided %}{{0.0|plus:AngularOffset}}
														{% elsif dir == 'none' and LeftSided %}{{180.0|plus:AngularOffset}}
														{% else %}45.0
														{% endif %}"/>
   <BlockNameFormat JoinBy="-">
				NO-BN-2D-JBTEH_FUN-KL-FUNDAMENT
				{% if    Variant == 'Concrete OCS foundation, cantilever mast' %}BETONG-BJELKEMAST-1600x{{OcsFoundationBaseWidth}}-{{OcsFoundationBaseOffset}}-191x374xM36
				{% elsif Variant == 'Bored OCS foundation, Ø555-191x374xM36' %}BETONG-BORET-Ø555-191x374xM36
				{% elsif Variant == 'Bored OCS foundation, Ø355-Ø232xDD27xM36' %}BETONG-BORET-Ø355-Ø232xDD27xM36
				{% elsif Variant == 'Rock bolts for OCS mast in tunnel' %}FJELLBOLTER-FOR-BRU-OG-TUNNEL-350x350xM24
				{% elsif Variant == 'Rock bolts for OCS mast on wall bracket' %}FJELLBOLTER-FOR-VEGGKONSOLL-600x700xM24
				{% elsif Variant == 'Wall bracket for OCS mast' %}VEGGKONSOLL-191x374xM36
				{% elsif Variant == 'Special OCS foundation' %}SPESIAL-191x374xM36
				{% elsif Variant == 'Concrete OCS foundation, low B3 and B6, 240x800xM36, 6000-9500' %}BETONG-B3-B6-LAV-1600x1800-000-240x800xM36
				{% elsif Variant == 'Concrete OCS foundation, high B6, 260x940xM36, 10000-13000' %}BETONG-B6-HOEY-1600x1800-{{OcsFoundationBaseOffset}}-260x940xM36
				{% elsif Variant == 'Concrete OCS foundation, H3, 700x700xM36, 6000-9500' %}BETONG-H3-1600x{{OcsFoundationBaseWidth}}-{{OcsFoundationBaseOffset}}-700x700xM36-6000-9500
				{% elsif Variant == 'Concrete OCS foundation, H3, 790x790xM36, 10000-12000' %}BETONG-H3-1600x{{OcsFoundationBaseWidth}}-{{OcsFoundationBaseOffset}}-790x790xM36-10000-12000
				{% elsif Variant == 'Concrete OCS foundation, H3, 830x830xM36, 12500-13000' %}BETONG-H3-1600x{{OcsFoundationBaseWidth}}-{{OcsFoundationBaseOffset}}-830x830xM36-12500-13000
				{% else %}BAD_Variant_{{Variant}}
				{% endif %}
				{{SymbolMode}}
			</BlockNameFormat>
  </SymbolDefinition>
