  <CustomProperty DataType="String" Name="TextAbove" DisplayName="Text above" DefaultValue="" Description="Text above balise symbol [string] according to Bane NOR TRV 550 ch. 10 ATC tables 7.1 and 7.2."/>
  <CustomProperty DataType="String" Name="TextBelow" DisplayName="Text below" DefaultValue="" Description="Text below  balise symbol [string] according to Bane NOR TRV 550 ch. 10 ATC table 7.11."/>
  <CustomProperty DataType="Boolean" Name="FirstInGroup" DisplayName="First in group" DotLiquidExpression="
         {% if Variant == 'Filled/fixed' %}True
         {% elsif Variant == 'Filled/controlled' %}True
