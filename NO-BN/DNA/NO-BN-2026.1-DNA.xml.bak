  <LuaExpression Name="Color">
   <Formula>_JBTEH_KTL_getContactWireOrderedVertices()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_getContactWireOrderedVertices()" ReturnType="String" Description="Returns an ordered table containing the vertices for a contact wire's 3D geometry.">
   <Signature>Table of {Double X, Double Y} _JBTEH_KTL_getContactWireOrderedVertices(ObjectReference contactWire)</Signature>
   <Formula>
				function _JBTEH_KTL_getContactWireOrderedVertices(cow)
					cow = cow or this

					function getVertex(obj) return obj.RcType == rctype_Cantilever and NOBN_ocs_getWireClampPoint3D(obj) or getPoint3D(obj) end

					local consolesOnOcsPole = table.select(cow:getRelatedObjects(rel_ContactWireOrMidpointAnchoringLineOrHvConductor_IsTensionedBy_Wtb), function (x) return table.firstOrNil(x:getRelatedObjects(rel_GuyWireOrSpannerOrWtb_IsAttachedTo_ConsoleOnOcsPole)) end)
					local cantilevers = table.select(cow:getRelatedObjects(rel_ContactWire_IsHeldBy_Cantilever))
					local objectsAtVertices = table.select(getUnionOfCollections({consolesOnOcsPole, cantilevers}))

					--Make table of vertices {Double X, Double Y}
					local vertices = {}
					for _, v in pairs(objectsAtVertices) do table.insert(vertices, getVertex(v)) end

					--Find center of gravity of all vertices
					local g = getPoint3D(0,0)
					for _, v in pairs(vertices) do g = getVectorSum(g, v) end
					g = getVectorScalarProduct(1/#vertices, g)

					--Find the vertex f which is the most distant from the center of gravity (largest squared 2D distance)
					local maxDist = -1
					local f
					for _, v in pairs(vertices) do
						local d = (v.X - g.X)^2 + (v.Y - g.Y)^2
						if d &gt; maxDist then maxDist = d f = v end
					end

					--Let gf be the 2D vector from g to f, to be used as a yardstick to order all vertices
					gf = getPoint3D(f.X - g.X, f.Y - g.Y)

					--Sort vertices a, b according to XY plane dot products ga.gf vs gb.gf - the vertices should be more or less on a fairly straight line
					table.sort(vertices, function (a, b)
						ga = getPoint3D(a.X - g.X, a.Y - g.Y)
						gb = getPoint3D(b.X - g.X, b.Y - g.Y)
						local gagf = getVectorDotProduct(ga, gf)
						local gbgf = getVectorDotProduct(gb, gf)
						return gagf &gt; gbgf
					end)
					return vertices
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="RcAlignment.HorizontalGeometry.Segments">
   <Formula>_JBTEH_KTL_getContactWireHorizontalGeometrySegments(this)</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_getContactWireHorizontalGeometrySegments()" ReturnType="String" Description="Returns an ordered sequence of horizontal segments for use in the contact wire's RcAlignment.HorizontalGeometry.Segments property.">
   <Signature>HorizontalSegments _JBTEH_KTL_getContactWireHorizontalGeometrySegments(ObjectReference contactWire)</Signature>
   <Formula>
				function _JBTEH_KTL_getContactWireHorizontalGeometrySegments(cow)
					cow = cow or this
					local lib1 = includeLuaFile("Lua\\Functions\\lib1.lua")
					local vertices = _JBTEH_KTL_getContactWireOrderedVertices(cow)
					local segments = {}
					for i = 2, #vertices do
						table.insert(segments, lib1.createHorizontalGeometryStraightSegment(vertices[i-1], vertices[i]))
					end
					return segments
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="Color">
   <Formula>_JBTEH_KTL_Color()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_Color()" ReturnType="String" Description="Returns the CAD system's polyline color, based on the wire's Wire2dColor property.">
   <Signature>String _JBTEH_KTL_Color()</Signature>
   <Formula>
				function _JBTEH_KTL_Color()
					if     Wire2dColor == "Black"  then return 7 --Displays as white
					elseif Wire2dColor == "Blue"   then return "30,144,255"
					elseif Wire2dColor == "Purple" then return "148,0,211"
					elseif Wire2dColor == "Red"    then return "252,10,28"
					elseif Wire2dColor == "Brown"  then return "139,69,19"
					elseif Wire2dColor == "Orange" then return "255,140,0"
					elseif Wire2dColor == "Green"  then return "50,205,50"
					elseif Wire2dColor == "Yellow" then return 2
					else return 7 --white
					end
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="Lineweight">
   <Formula>_JBTEH_KTL_Lineweight()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_Lineweight()" ReturnType="Double" Description="Returns the CAD system lineweight (line width in print) for the catenary wire, based on its Wire2dColor property.">
   <Signature>Double _JBTEH_KTL_Lineweight()</Signature>
   <Formula>
				--AutoCAD needs lineweights to be of the form "Lineweight035" for "0.35 mm" (only predefined Values according to AutoCAD enum):
				function _JBTEH_KTL_Lineweight()
					if Wire2dColor == "Black" then
						return "Lineweight035"
					else
						return "Lineweight040"
					end
				end
			</Formula>
  </LuaFunction>
  <LuaExpression Name="SweptGeometry3D_0.Roll">
   <Formula>NOBN_com_getRollFromCantInterpretedAsDecimalDegrees(_position)</Formula>
  </LuaExpression>
  <LuaExpression Name="SweptGeometry3D_0.Name">
   <Formula>_JBTEH_KTL_Geometry3DName()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_Geometry3DName()" ReturnType="Double" Description="Returns the wire's 3D geometry name, based on its Variant and material.">
   <Signature>Double _JBTEH_KTL_Geometry3DName()</Signature>
   <Formula>
				function _JBTEH_KTL_Geometry3DName()
					if Variant == "Contact Wire from tension balancer to tension balancer" then
						return "NO-BN-2D-EH-KTL-KONTAKTTRÅD-"..ContactWireMaterial:gsub(" ","-")
					else
						return "Bad Variant ["..Variant.."]."
					end
				end
			</Formula>
  </LuaFunction>
  <CustomProperty DataType="String" ReadOnly="true" Category="Model check" Name="mc_Relations" DisplayName="Relations" Description="Checks complex requirements on the number of established relations between this object and other objects."/>
  <LuaExpression Name="mc_Relations" IsModelCheck="true">
   <Formula>_JBTEH_KTL_chkRelations()</Formula>
  </LuaExpression>
  <LuaFunction Name="_JBTEH_KTL_chkRelations()" ReturnType="String" Description="A contact wire alignment shall relate to cantilevers, midpoint anchor and WTB.">
   <Signature>String _JBTEH_KTL_chkRelations()</Signature>
   <Formula>
				function _JBTEH_KTL_chkRelations()
					local _rWtb, nWtb = getRelatedObjects(rel_ContactWireOrMidpointAnchoringLineOrHvConductor_IsTensionedBy_Wtb)
					local _rCnt, nCnt = getRelatedObjects(rel_ContactWire_IsHeldBy_Cantilever)
					local _rMap, nMap = getRelatedObjects(rel_ContactWire_IsLockedBy_MidpointAnchor)

					--Regular CW:
					if Variant == "Contact Wire from tension balancer to tension balancer" then
						if nWtb == 0 then
							if nCnt &gt; 0 then
								if nMap == 0 or nMap == 1 then
									return _ok,"OK - Regular CW is related to at least one cantilever, to zero or one midpoint anchor, no WTB."
								else
									return _error,"ERROR - Regular CW has too many midpoint anchors."
								end
							else
								return _unfinished,"UNFINISHED - Regular CW shall relate to at least one cantilever."
							end
						else
							return _error,"ERROR - Regular CW shall not relate to a WTB."
						end

					else
						return _error,"ERROR - Bad variant '"..Variant.."'."
					end
				end
			</Formula>
  </LuaFunction>
  <CustomProperty DataType="String" Name="mc_OtherObjectsToBeModelchecked" ReadOnly="true" Category="Model check" DisplayName="Other objects to model check" Description="When this contact wire is refreshed, then all point objects in 2D closer than 0.1 m from the alignment are modelchecked as well."/>
