<!-- Position tool interface function names - suggested naming conventions:
	
	Name part							Example									Comment
	=================================	=====================================	==============================================
	<4-letter administration code>		NOBN									XXGL, NOBN, FRSR, DEDB etc
	Separator							_										
	Discipline							com										Since alignments are common to many disciplines, not only track)
	Separator							_										
	Corresponding ResX element's key	PositionTransient_Set_Alignment_Own		RC looks up the ResX alias for the key and inserts this textobject
-->

 
<!--
	Each PositionTool Lua function should accept exactly one argument of type PositionToolInfo. A PositionToolInfo element has the following fields:
    PositionToolInfo
    {
		public Point 				CursorPosition;
        public AlignmentReference	OwnAlignment;
        public AlignmentReference	RefAlignment;
        public double				OwnPos;
        public double				RefPos;
        public double?				Value;
        public bool?				OwnMileageIncreasesTowardsLeft;
        public bool?				RefMileageIncreasesTowardsLeft;
    },
	where Value is whatever numeric value is to be displayed, if any. This could be e.g. mileage or elevation.
	The below position tool settings replace default C# behavior.
	Note: 'double? Xxxx' means that indentifier Xxxxx is allowed to return the 'nil' value ('null' in C#).
-->

<PositionToolSettings Name="NOBN_PositionToolSettings">
  	<PositionToolTextLines>
		<!-- TODO: Remove? <OwnAlignmentOffset						OrderPriority="8" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Offset_Own"/> -->
 		<OwnAlignmentNameOrCodeOrId				OrderPriority="6" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_AlignmentName_Own"/>
		<OwnAlignmentDistanceToAlignment		OrderPriority="4" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_DistanceToAlignment_Own"/>
		<OwnAlignmentElevation					OrderPriority="3" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Elevation_Own"/>
		<!-- TODO: Deprecate <OwnAlignmentPos> => <OwnAlignmentDistanceAlong> -->
  		<OwnAlignmentPos						OrderPriority="2" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_DistanceAlong_Own"/>
  		<OwnAlignmentMileage					OrderPriority="1" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Mileage_Own"/>
		
		<!-- TODO: Remove? <ReferenceAlignmentOffset				OrderPriority="7" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Offset_Ref"/> <!-- Not implemented yet -->
		<ReferenceAlignmentNameOrCodeOrId		OrderPriority="5" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_AlignmentName_Ref"/>
  		<!-- <ReferenceAlignmentDistanceToAlignment> is not used because it would be confusing -->
		<ReferenceAlignmentElevation			OrderPriority="3" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Elevation_Ref"/>
		<!-- TODO: Deprecate <ReferenceAlignmentPos> into <ReferenceAlignmentDistanceAlong> -->
  		<ReferenceAlignmentPos						OrderPriority="2" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_DistanceAlong_Ref"/>
  		<ReferenceAlignmentMileage					OrderPriority="1" PositionToolFormatLuaFunctionName="NOBN_trk_PositionTransient_Set_Km"/>
  	</PositionToolTextLines>
</PositionToolSettings>



<LuaFunction Name="NOBN_trk_PositionTransient_Set_AlignmentName_Own()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the current alignment's identification (name, code, id), as picked up by the position tool, plus its direction of increasing mileages shown as three angle brackets. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'OwnAlignment' [AlignmentReference] which is the current Own Alignment picked up by the CAD cursor, plus 'MileageIncreasesTowardsLeft' [Boolean] which tells whether the own alignment's Mileage Increases Towards Left as viewed on the user's computer screen. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Alignment_Own'. See also ISO 19148:2012 — Geographic information — Linear referencing."">
	<Signature>String NOBN_trk_PositionTransient_Set_AlignmentName_Own(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_AlignmentName_Own(positionToolInfo)
			local oa = RC__identify(positionToolInfo.OwnAlignment)
			if positionToolInfo.OwnMileageIncreasesTowardsLeft then 
				return "OWN: &lt;&lt;&lt; "..oa --prefix own alignment with left angle bracket
			else
				return "OWN: "..oa.." &gt;&gt;&gt;" --postfix own alignment with right angle brackets
			end
		end
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_AlignmentName_Ref()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the CAD cursor's reference alignment identification (name, code, GUID) corresponding to the current alignment, as picked up by the position tool, plus its direction of increasing mileages shown as three angle brackets. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'RefAlignment' [AlignmentReference] which is the current Reference Alignment picked up by the CAD cursor, plus 'MileageIncreasesTowardsLeft' [Boolean] which tells whether the reference alignment's Mileage Increases Towards Left as viewed on the user's computer screen. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Alignment_Ref'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_AlignmentName_Ref(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_AlignmentName_Ref(positionToolInfo)
			local ra = RC__identify(positionToolInfo.RefAlignment)
			if positionToolInfo.RefMileageIncreasesTowardsLeft then 
				return "REF: &lt;&lt;&lt; "..ra --prefix reference alignment with left angle bracket
			else
				return "REF:  "..ra.." &gt;&gt;&gt;" --postfix reference alignment with right angle brackets
			end
		end
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_DistanceToAlignment_Own()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the current CAD cursor's distance from the current alignment, as picked up by the position tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the horizontal Distance (lateral offset) from the CAD cursor to the current Own alignment. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Distance_Own'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
 	<Signature>String NOBN_trk_PositionTransient_Set_DistanceToAlignment_Own(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_DistanceToAlignment_Own(positionToolInfo)
			local od = positionToolInfo.Value
			return string.format("Distance to own alignment %.03f m", od)
		end 
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_Elevation_Own()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the elevation at the CAD cursor, measured in the current alignment, as picked up by the position tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the Elevation (vertical profile Z value) measured in the current alignment at the CAD cursor's projection. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Elevation_Own'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_Elevation_Own(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_Elevation_Own(positionToolInfo)
			local oe = positionToolInfo.Value
			return oe and string.format("Elevation of own alignment %.03f m", oe) or "Elevation of own alignment (no data)"
		end
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_Elevation_Ref()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the elevation at the CAD cursor, measured in the reference alignment corresponding to the current alignment, as picked up by the position tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] which is the Elevation (vertical profile Z value) measured in the reference alignment at the CAD cursor's projection. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Elevation_Ref'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_Elevation_Ref(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_Elevation_Ref(positionToolInfo)
			--Do not code as 'local re = positionToolInfo.Value' because this function shall return info about the OWN alignment also when the Position Tool is in REF Mode.
			local re = getAlignmentInfo(getAlignmentPos(positionToolInfo.OwnAlignment.id, positionToolInfo.OwnPos)).Elevation
			return re and string.format("Elevation of reference alignment %.03f m", re) or  "Elevation of reference alignment (no data)"
		end
	</Formula>
</LuaFunction>
  
<LuaFunction Name="NOBN_trk_PositionTransient_Set_Mileage_Own()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the chainage ('mileage' in RC, 'Position' in NRV) at the CAD cursor, measured along the current alignment, as picked up by the position tool. This 'own mileage' is the result of an initial start mileage plus the distance along measured from start of alignmment up to the CAD cursor's projection onto it, adjusted by possible chain breaks / mileposts along the own alignment. Mileage information can be inspected and adjusted from the Alignment Manager tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the mileage measured along the applicable Own alignment where the CAD cursor's projection is. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Mileage_Own'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_Mileage_Own(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_Mileage_Own(positionToolInfo)
			local om = positionToolInfo.Value
			return string.format("Mileage in own alignment %.03f m", om)
		end
	</Formula>
</LuaFunction>

<!--
Note on chain brakes / milepost modeling in IFC, railML and RailCOMPLETE
========================================================================
The IFC 4.3 Add2 Alignment's property set "Pset_Stationing" has these properties:

IncomingStation ::= IfcPropertySingleValue / IfcLengthMeasure
The optional station value of the incoming segment that ends at this location. This value needs to be set if the intention is to
specify a station equation, i.e. a location where stationing changes.

Station ::= IfcPropertySingleValue / IfcLengthMeasure
The station value at this location [to be used as outgoing mileage]

HasIncreasingStation ::= IfcPropertySingleValue / IfcBoolean
Inform on the increasing or decreasing progress of stationing values, for referents nested in a given alignment. If present and
true, or if not present, then the relevant subsequently nested referents are expected to have greater Pset_Stationing.Station
values (i.e., increasing stations). If present and false, then the relevant subsequently nested referents are expected to have
lower Pset_Stationing.Station values (i.e., decreasing stations).

Additional note on railML: After discussions in railML.org, it was decided for railML 3.x that the direction of increasing mileages
cannot be reversed inside an alignment. You will have to cut an start a new one that runs in the opposite direction. Trimble
Novapoint track design software and Railcomplete's  RailCOMPLETE software follow the railML approach.

The RailCOMPLETE data structure that corresponds to IFC's PsetStationing is this one, as seen from a RC point object:

	Alignment.RcAlignment.Mileage.Items[j].Mileage		--The outgoing station value at chain break / milepost index 'j'
	Alignment.RcAlignment.Mileage.Items[j].Mileage		--The outgoing station value at chain break / milepost index 'j'
-->
	<!-- TODO: Replace absolute linear measurement with relative, when EIHOV has merged this feature into github develop. -->
<LuaFunction Name="NOBN_trk_PositionTransient_Set_Km()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the chainage ('ReferenceMileage' in RailCOMPLETE, 'Mileage' in NRV, an absolute linear address) at the current CAD cursor, measured along the reference alignment corresponding to the current alignment, as picked up by the position tool. The reference mileage is the result of an initial start mileage plus the distance along measured from start of the reference alignmment up to the cursor's projection onto it, adjusted by possible chain breaks / mileposts along the reference alignment. Mileage information can be inspected and adjusted from the Alignment Manager tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the mileage measured along the applicable Reference alignment where the CAD cursor's projection is. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Mileage_Ref'.">
 	<Signature>String NOBN_trk_PositionTransient_Set_Km(PositionToolInfo positionToolInfo)</Signature>
	<Formula>
		function NOBN_trk_PositionTransient_Set_Km(positionToolInfo)
			--This is an absolute address, using numeric kilometration values starting with the closest preceding ref chain break / milepost.
			--TODO: Make also a real "Relative addressing Km", relative to physical referents (Km boards), look to FRSR's function FRSR_TFVA_PositionTransient_Set_PK(...).
			local rm = positionToolInfo.Value
			return string.format("Km.%.03f [%.03f]", rm/1000, rm)
			--TODO:Remove this absolute address presentation (uses comma) if or when relative is made possible (uses plus-sign).
			--TODO: Adapt a *relative* address presentation when mileage referents have been added to RC:
			--return string.format("Km.%s+%05.01f", closestPrecedingReferentName, distanceInRefAlignmentToClosestPrecedingReferentPlusItsStationValue)
		end
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_DistanceAlong_Own()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the CAD cursor's distance along (DistanceALong) the current alignment, to be displayed by the position tool. The DistanceAlong is the distance along the current alignment's horizontal geometry, measured from zero at the beginning of the horizontal geometry of the current alignment up to the CAD cursor's projection onto this alignment. The distance along is unaffected by possible chain breaks or mileposts. Position information can be inspected and adjusted from the Alignment Manager tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the distance along  measured along the current alignment where the CAD cursor's projection is. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Pos_Ref'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_DistanceAlong_Own(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_DistanceAlong_Own(positionToolInfo)
			local oda = positionToolInfo.Value
			return string.format("Distance along own alignment %.03f m", oda)
		end
	</Formula>
</LuaFunction>

<LuaFunction Name="NOBN_trk_PositionTransient_Set_DistanceAlong_Ref()" ReturnType="String" HideFromUser="false" 
	Description="Returns a formatted string containing the current CAD cursor's distance along the reference alignment, to be displayed by the position tool. The distance along the reference alignment is the distance along the reference alignment's horizontal geometry, measured from zero at the beginning of the horizontal geometry of the reference alignmment up to the CAD cursor's projection onto it, unaffected by possible chain breaks / mileposts. Position information can be inspected and adjusted from the Alignment Manager tool. When RC uses the function, then RC provides the required input 'positionToolInfo' which contains 'Value' [Double] [m] which is the distance along measured along the applicable Reference alignment where the CAD cursor's projection is. Note: If this function is not provided to the position tool, then RC will format a suitable default text using the current translation found in the  built-in language pack system (ResX) for key 'PositionTransient_Set_Pos_Ref'. See also ISO 19148:2012 — Geographic information — Linear referencing.">
	<Signature>String NOBN_trk_PositionTransient_Set_DistanceAlong_Ref(PositionToolInfo positionToolInfo)</Signature>
 	<Formula>
		function NOBN_trk_PositionTransient_Set_DistanceAlong_Ref(positionToolInfo)
			local rda = positionToolInfo.Value
			return string.format("Distance along reference alignment %.03f m", rda)
		end
	</Formula>
</LuaFunction>
		


