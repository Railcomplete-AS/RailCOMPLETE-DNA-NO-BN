<!--========================================================================================================
	Standard TEXT ATTRIBUTES for OBJEKTNAVN, OBJEKTID, OBJEKTINFO (and a few others).

	Example - these are the attributes that may be set from DNA as attributes:
	<TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="MYTEXTATTRIBUTE"
		Layer="JBTEH@MYTEXTATTRIBUTE" Color="ByLayer" Justify="MiddleCenter" Height="1.25" Width="0" Rotation="0" ObliqueAngle="15" 
		Constant="false" Invisible="false" Lock="false" MText="true"
		Description="Blah, blah, blah."/>
	
	Note: ObjectType headers may include DotLiquid expressions that modify where the text item is placed
	initially (AttMirrorX, AttMirrorY etc). You should in general instead provide a LuaExpression that
	defines the text attribute's Position sub-property directly.

=========================================================================================================-->



<!--========================================================================================================
	NOBN_com_STD_TEXTATTRIBUTES___$discipline_$font
	
	where $discipline is one of:
		COM	= FE Felles (virtuelle objekter m.m.)
		SUB	= KU Underbygning (fundamenter)
		TRK = KO Overbygning (spor, ballast, plattformer)
		OCS = EH Elektro høyspent (kontaktledning, jording, høyspentkabler og brytere)
		SIG = SA Signal
		POW = EL Elektro lavspent (gruppeskap, strømforsyning inntil 1000V)
		TEL = TE Telematikk
	
	and $font is one of:
		NORMAL = horizontal normal font
		SMALL = horizontal smaller font
		LARGE = horizontal larger font
		VERTICAL = vertical normal font
		
=========================================================================================================-->
<xpp:define name="NOBN_com_STD_TEXTATTRIBUTES___COM_NORMAL">
	<xpp:bloc>
		<TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTNAVN" 
			Layer="JBTFE@OBJEKTNAVN" Color="ByBlock" Justify="MiddleCenter" Height="1.25" Rotation="0" ObliqueAngle="15"/>
		<TextAttribute Annotative="true" Style="RC-ARIAL" CadAttributeTag="OBJEKTID"
			Layer="JBTFE@OBJEKTID" Color="ByLayer" Justify="MiddleCenter" Height="0.9" Rotation="0" ObliqueAngle="0"/>
