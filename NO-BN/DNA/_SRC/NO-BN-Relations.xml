	<!-- Anchoring -->
	<!-- An anchor can connect any number of incoming / outgoing wires, minimum one. -->
	<!-- An OCS anchor provides a torsion-free connection between an OCS foundation / OCS pole) with a wire tension balancer, guywire or spanner. -->
	<!-- Anchors are objects that ensure that forces resulting from contact wires / cables (through a suitable wire tension balancer),  -->
	<!-- from guywires or from spanners, as well as the corresponding reaction forces from the anchor's OCS pole or foundation / bolt group, -->
	<!-- do not cause the anchor object to move (i.e., sum of forces is zero) or to rotate (i.e., sum of moments is zero) -->
	<Relations>
		<SourceSpace>konsoll_på_mast</SourceSpace>

		<Relation Name="OCS console on pole - pole association" AskForRelation="true" AskForReverseRelation="false" Color="254"
				Description="Relation for associating an anchoring console to the OCS pole it is installed on."
				ForwardLuaName="rel_ConsoleOnOcsPole_IsInstalledOn_OcsPole"
				ReverseLuaName="rel_OcsPole_IsInstallationTargetFor_ConsoleOnOcsPole">
			<TargetSpace>kl-mast</TargetSpace>
			<RelatesTo Prompt="Is console on pole for" WarnAtSaturation="true" Min="1" Max="1"/>
			<ReverseRelatesTo Prompt="Has" WarnAtSaturation="true" Min="0" Max="2"/>
		</Relation>

		<!-- Condensed DNA: removed avspenning and kl-strever TargetSpaces (types removed from OcsWireSystem) -->
		<Relation Name="OCS console for guy wire on pole" AskForRelation="true" AskForReverseRelation="true" Color="254"
				Description="Relation for associating an anchoring device on OCS pole to the guywire it anchors to the OCS pole."
				ForwardLuaName="rel_ConsoleOnOcsPole_Anchors_GuyWireOrSpannerOrWtb"
				ReverseLuaName="rel_GuyWireOrSpannerOrWtb_IsAttachedTo_ConsoleOnOcsPole">
			<TargetSpace>kl-bardun</TargetSpace>
			<RelatesTo Prompt="Is console on pole for" WarnAtSaturation="true" Min="1" Max="inf" NumberOfPromptsDuringInsertion="2"/>
			<ReverseRelatesTo Prompt="Is attached to" WarnAtSaturation="true" Min="0" Max="1"/>
		</Relation>
	</Relations>

