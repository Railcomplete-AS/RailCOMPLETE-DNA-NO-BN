{
  "permissions": {
    "allow": [
      "Task",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(cd:*)",
      "Bash(tail *)",
      "Bash(dir:*)",
      "Bash(findstr:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(where:*)",
      "Bash(awk:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block_cd_chaining.sh"
          }
        ]
      }
    ]
  }
}
